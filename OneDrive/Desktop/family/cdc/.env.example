# Redis Configuration
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_KEY=outbox:events
REDIS_DLQ_STREAM_KEY=outbox:dlq

# Consumer Configuration
CONSUMER_GROUP_NAME=replay-consumers
CONSUMER_NAME=consumer-1
CONSUMER_BATCH_SIZE=10
CONSUMER_BLOCK_TIME=5s

# gRPC Configuration
# Format: "type1:address1,type2:address2"
GRPC_TARGETS=order:localhost:50051,payment:localhost:50052,user:localhost:50053
GRPC_TIMEOUT=30s

# Retry Configuration
MAX_RETRIES=3
INITIAL_BACKOFF=1s
MAX_BACKOFF=60s
BACKOFF_MULTIPLIER=2.0

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
